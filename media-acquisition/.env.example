# Copy this file to .env and fill in your values.
# Run `id` in a terminal to find your PUID and PGID.

# ── External drive mount point ────────────────────────────────────────────────
# Where your external drive is mounted on this laptop.
# Common locations:
#   Linux:  /mnt/external  (after running setup.sh)
#   macOS:  /Volumes/MY_DRIVE
MEDIA_ROOT=/mnt/external

# ── Your user / group IDs ─────────────────────────────────────────────────────
# Run `id` to find these. Defaults to 1000 which is typical for the first user.
PUID=1000
PGID=1000

# ── Timezone ──────────────────────────────────────────────────────────────────
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Berlin
