TZ=Europe/Berlin

# Pi-hole admin password — set a strong one (Pi-hole v6: FTLCONF_webserver_api_password)
PIHOLE_PASSWORD=changeme

# Cloudflare Tunnel token — get from: cloudflared tunnel token oryx
# Leave empty until you run: cloudflared tunnel create oryx
CLOUDFLARE_TUNNEL_TOKEN=

# Immich API key — generate at https://photos.aritra.fyi/user-settings?isOpen=api-keys
IMMICH_API_KEY=

# Nextcloud — generate app password at https://drive.aritra.fyi/settings/user/security
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_APP_TOKEN=
# NEXTCLOUD_BASIC_AUTH = base64(user:app_token) — generate with:
#   echo -n "admin:your_app_token" | base64
NEXTCLOUD_BASIC_AUTH=
