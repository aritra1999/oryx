    {
      "id": "d1e2f3a4-0009-0000-0000-000000000009",
      "name": "Filter + Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        380
      ],
      "parameters": {
        "jsCode": "const cutoff = Date.now() - 24 * 60 * 60 * 1000;\n\nconst recent = $input.all().filter(item => {\n  const date = new Date(item.json.isoDate || item.json.pubDate || 0).getTime();\n  return date > cutoff;\n});\n\nif (recent.length === 0) {\n  throw new Error('No articles published in the last 24 hours — nothing to digest.');\n}\n\nconst articles = recent\n  .sort((a, b) => new Date(b.json.isoDate || 0) - new Date(a.json.isoDate || 0))\n  .map(item => {\n    const title = (item.json.title || 'Untitled').replace(/\\n/g, ' ').trim();\n    const link = item.json.link || '';\n    const snippet = (item.json.contentSnippet || item.json.content || '')\n      .replace(/<[^>]*>/g, '')\n      .replace(/\\s+/g, ' ')\n      .slice(0, 400)\n      .trim();\n    return `- ${title}\\n  ${link}${snippet ? '\\n  ' + snippet : ''}`;\n  })\n  .join('\\n\\n');\n\nconst prompt = `You are a tech news curator writing a daily reading digest for a software engineer. From the articles below select the 10 most important stories. Return ONLY a valid JSON array — no prose, no markdown fences, no explanation.\n\nEach element must have exactly these fields:\n- \"section\": thematic group with emoji (e.g. \"⚖️ Legal\", \"🤖 AI & Models\", \"📱 Industry\", \"🔐 Security\", \"🛠️ Dev & Tooling\")\n- \"title\": story title, max 80 chars\n- \"url\": article URL\n- \"summary\": 4–5 sentences (max 800 chars). Cover: what happened, the key technical or business detail, why it matters to a software engineer, and any notable implication or next step to watch.\n- \"tags\": array of 3–4 lowercase tag strings\n\nArticles (past 24h):\n\n${articles}`;\n\nconst body = JSON.stringify({\n  contents: [{ parts: [{ text: prompt }] }],\n  generationConfig: { temperature: 0.3, maxOutputTokens: 2048, responseMimeType: 'application/json' }\n});\n\nreturn [{ json: { body, articleCount: recent.length } }];"
      }
    },
    {
      "id": "d1e2f3a4-0010-0000-0000-000000000010",
      "name": "Gemini 3.8 Flash",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1420,
        380
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent?key={{ $env.N8N_GEMINI_API_KEY }}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}"
      }
    },
    {
      "id": "d1e2f3a4-0011-0000-0000-000000000011",
      "name": "Extract Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        380
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst text = response?.candidates?.[0]?.content?.parts?.[0]?.text;\nif (!text) {\n  throw new Error('Gemini returned no text. Response: ' + JSON.stringify(response).slice(0, 500));\n}\n\n// Find the JSON array by bracket position — robust against leading/trailing garbage\nconst start = text.indexOf('[');\nconst end = text.lastIndexOf(']');\nif (start === -1 || end === -1) {\n  throw new Error('No JSON array found in Gemini response: ' + text.slice(0, 500));\n}\n\nlet stories;\ntry {\n  stories = JSON.parse(text.slice(start, end + 1));\n} catch (e) {\n  throw new Error('JSON parse failed: ' + e.message + '\\nRaw: ' + text.slice(start, start + 500));\n}\n\nif (!Array.isArray(stories)) throw new Error('Expected a JSON array from Gemini');\n\nreturn stories.slice(0, 10).map(s => ({ json: s }));"
      }
    },
    {
      "id": "d1e2f3a4-0012-0000-0000-000000000012",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        380
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ username: 'Tech Digest', content: $json.section + '\\n**' + $json.title + '** ([read](' + $json.url + '))\\n' + $json.summary + '\\n' + ($json.tags || []).map(t => '`#' + t + '`').join(' ') }) }}"
      }
    }
  ],
