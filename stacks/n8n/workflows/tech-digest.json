        "body": "={{ JSON.stringify({ username: 'Tech Digest', content: '\\ud83d\\udcf0 **Tech Digest \\u2014 ' + $today.toFormat('cccc, LLLL d') + '**\\n\\n' + $json.digest }) }}"
      }
    }
