# Budibase admin account (auto-created on first boot)
BB_ADMIN_EMAIL=admin@example.com
BB_ADMIN_PASSWORD=changeme

# Budibase internal secrets — generate with: openssl rand -hex 32
BB_JWT_SECRET=
BB_MINIO_ACCESS_KEY=
BB_MINIO_SECRET_KEY=
BB_REDIS_PASSWORD=
BB_COUCHDB_USER=budibase
BB_COUCHDB_PASSWORD=

# Filled in after first boot (see README step 3)
BB_API_KEY=
BB_APP_ID=
